<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle identity -->
    <key>CFBundleName</key>
    <string>Scripter</string>
    <key>CFBundleDisplayName</key>
    <string>Scripter</string>
    <key>CFBundleIdentifier</key>
    <string>com.scripter.app</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>scripter</string>
    <key>CFBundleIconFile</key>
    <string></string>

    <!-- System requirements -->
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- 后台应用：不占 Dock、启动无窗口，靠全局快捷键唤起 Launcher -->
    <key>LSUIElement</key>
    <true/>

    <!-- 让 Finder 显示为后台应用，不出现在 Cmd+Tab 切换列表 -->
    <key>LSBackgroundOnly</key>
    <true/>

    <!-- 权限说明（首次请求时系统弹窗会用到） -->
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Scripter</string>
    <key>NSRequiresAquaSystemAppearance</key>
    <false/>

    <!--
      注意：本应用需要以下用户授权才能完整工作：
        - 辅助功能（Accessibility）：`typeStr` 注入按键
        - 屏幕录制（Screen Recording）：`scanQr` 截屏
      这两个权限无法在 Info.plist 里声明，首次调用对应 API 时系统会自动弹窗。
    -->
</dict>
</plist>
