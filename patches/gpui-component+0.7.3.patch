+impl CommandState {
+    /// The built-in search field: rendered above the list by default, or below
+    /// it (with a top border) when the `search_bottom` option is set.
+    fn render_search_input(
+        &self,
+        icon: gpui_kit_assets::IconName,
+        size: crate::Size,
+        bottom: bool,
+        cx: &App,
+    ) -> Div {
+        div()
+            .flex_none()
+            .px_3()
+            .when(!bottom, |this| this.border_b_1())
+            .when(bottom, |this| this.border_t_1())
+            .border_color(cx.theme().border)
+            .child(
+                Input::new(&self.query_input)
+                    .prefix(Icon::new(icon).text_color(cx.theme().muted_foreground))
+                    .appearance(false)
+                    .p_0()
+                    .with_size(size),
+            )
+    }
+}
