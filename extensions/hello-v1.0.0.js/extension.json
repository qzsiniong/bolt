{
  "$schema": "../extension.schema.json",
  "id": "hello",
  "name": "Hello",
  "version": "1.0.0",
  "permissions": ["typeStr"],
  "commands": [
    {
      "id": "ui",
      "title": "UI",
      "ui": {
        "title": "UI窗口",
        "width": 180,
        "height": 120,
        "always_on_top": true,
        "capabilities": { "clipboard": true },
        "actions": [
            { "builtin": "reload" },
            { "builtin": "open_data_dir" },
            { "builtin": "open_plugin_dir" },
            { "builtin": "close_window" },
            { "command": "sayHello" }
        ]
      }
    },
    {
      "id": "sayHello",
      "title": "say hello",
      "description": "说hello"
    }
  ]
}
